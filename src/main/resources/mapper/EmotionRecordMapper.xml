<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.namedmoment.mapper.EmotionRecordMapper">

    <insert id="insert" parameterType="com.example.namedmoment.entity.EmotionRecord"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO emotion_record (input_text, concept_id, match_score, explanation)
        VALUES (#{inputText}, #{conceptId}, #{matchScore}, #{explanation})
    </insert>

    <delete id="deleteById">
        DELETE FROM emotion_record
        WHERE id = #{id}
    </delete>

</mapper>
